generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                             Int                             @id @default(autoincrement())
  name                           String
  email                          String                          @unique
  passwordHash                   String                          @default("SUPABASE_AUTH")
  resetToken                     String?
  resetExpiry                    DateTime?
  createdAt                      DateTime                        @default(now())
  active                         Boolean                         @default(true)
  role                           String                          @default("user")
  mustChangePassword             Boolean                         @default(false)
  accountOwnerId                 Int?
  supabaseUid                    String?                         @unique
  plan                           String                          @default("essencial")
  isSuperAdmin                   Boolean                         @default(false)
  permissions                    String?
  jobTitle                       String?
  workspaceMode                  String                          @default("servicos")
  assignedEstabelecimentoId      String?
  billingType                    String                          @default("trial")
  trialEndsAt                    DateTime?
  expiresAt                      DateTime?
  graceEndsAt                    DateTime?
  accountStatus                  String                          @default("active")
  lastSeenAt                     DateTime?
  automations                    Automation[]                    @relation("AutomationUser")
  caixaSessoesFechadas           CaixaSessao[]                   @relation("CaixaSessaoClosedBy")
  caixaSessoesAbertas            CaixaSessao[]                   @relation("CaixaSessaoOpenedBy")
  caixaSessoes                   CaixaSessao[]                   @relation("CaixaSessaoUser")
  calendarSync                   CalendarSync?
  chatChannelMemberships         ChatChannelMember[]             @relation("ChatMemberUser")
  chatMessagesSent               ChatMessage[]                   @relation("ChatSenderUser")
  clientesFaturacao              ClienteFaturacao[]              @relation("ClienteFaturacaoUser")
  configuracaoFaturacao          ConfiguracaoFaturacao?          @relation("ConfigFaturacaoUser")
  contacts                       Contact[]                       @relation("ContactUser")
  contactFieldConfigs            ContactFieldConfig[]            @relation("ContactFieldConfigUser")
  contactFieldDefs               ContactFieldDef[]               @relation("ContactFieldDefUser")
  contactGroups                  ContactGroup[]                  @relation("ContactGroupUser")
  contactNotes                   ContactNote[]                   @relation("NoteAuthor")
  calendarEvents                 CalendarEvent[]                 @relation("CalendarEventUser")
  assignedCalendarEvents         CalendarEvent[]                 @relation("CalendarEventAssignee")
  estabelecimentos               Estabelecimento[]               @relation("EstabelecimentoUser")
  facturas                       Factura[]                       @relation("FacturaUser")
  facturaRecorrentes             FacturaRecorrente[]             @relation("FacturaRecorrenteUser")
  forms                          Form[]                          @relation("FormUser")
  googleCalendarEvents           GoogleCalendarEvent[]
  googleCalendarToken            GoogleCalendarToken?
  loginLogs                      LoginLog[]
  pipelineStages                 PipelineStage[]                 @relation("PipelineStageUser")
  produtos                       Produto[]                       @relation("ProdutoUser")
  produtoCategorias              ProdutoCategoria[]              @relation("ProdutoCategoriaUser")
  saftPeriodos                   SaftPeriodo[]                   @relation("SaftPeriodoUser")
  series                         Serie[]                         @relation("SerieUser")
  stockMovementsCreated          StockMovement[]                 @relation("StockMovementCreatedBy")
  stockMovements                 StockMovement[]                 @relation("StockMovementUser")
  assignedTasks                  Task[]                          @relation("TaskAssignee")
  tasks                          Task[]                          @relation("TaskUser")
  transactions                   Transaction[]                   @relation("TransactionUser")
  accountOwner                   User?                           @relation("AccountMembers", fields: [accountOwnerId], references: [id])
  accountMembers                 User[]                          @relation("AccountMembers")
  assignedEstabelecimento        Estabelecimento?                @relation("AssignedEstabelecimento", fields: [assignedEstabelecimentoId], references: [id])
  automationLogs                 AutomationLog[]
  automationAlerts               AutomationAlert[]
  dailyTipDeliveries             DailyTipDelivery[]
  startupTemplateApplied         StartupTemplateApplication?     @relation("StartupTemplateOrganization")
  startupTemplatesAppliedBy      StartupTemplateApplication[]    @relation("StartupTemplateAppliedBy")
  serviceDashboardSettings       ServiceDashboardSettings?
  financialCategories            FinancialCategory[]
  companies                      Company[]                       @relation("CompanyUser")
  deals                          Deal[]                          @relation("DealUser")
  dealStages                     DealStage[]                     @relation("DealStageUser")
  dealNotes                      DealNote[]                      @relation("DealNoteAuthor")
  membershipsAsPerson            AccountMembership[]             @relation("MembershipPerson")
  membershipsAsOwner             AccountMembership[]             @relation("MembershipAccountOwner")
  managementOrganization         ManagementOrganization?         @relation("ManagementOrganizationOwner")
  managementProfile              ManagementProfile?
  growthOrganizationOwned        GrowthOrganization?             @relation("GrowthOrganizationOwner")
  growthMemberships              GrowthMembership[]              @relation("GrowthMembershipUser")
  growthClientAccesses           GrowthClientAccess[]            @relation("GrowthClientAccessUser")
  foodSettings                   FoodSettings?                   @relation("FoodSettingsUser")
  foodBranches                   FoodBranch[]                    @relation("FoodBranchUser")
  foodCategories                 FoodCategory[]                  @relation("FoodCategoryUser")
  foodProducts                   FoodProduct[]                   @relation("FoodProductUser")
  foodModifierGroups             FoodModifierGroup[]             @relation("FoodModifierGroupUser")
  foodModifierOptions            FoodModifierOption[]            @relation("FoodModifierOptionUser")
  foodProductModifierGroups      FoodProductModifierGroup[]      @relation("FoodProductModifierGroupUser")
  foodOrders                     FoodOrder[]                     @relation("FoodOrderUser")
  organizationModules            OrganizationModule[]            @relation("OrganizationModuleOrganization")
  foodStaffOrganizations         FoodStaffRoleAssignment[]       @relation("FoodStaffOrganization")
  foodStaffRoles                 FoodStaffRoleAssignment[]       @relation("FoodStaffPerson")
  foodCredentialOrganizations    FoodStaffCredential[]           @relation("FoodStaffCredentialOrganization")
  foodCredentials                FoodStaffCredential[]           @relation("FoodStaffCredentialPerson")
  foodShiftOrganizations         FoodShift[]                     @relation("FoodShiftOrganization")
  foodShifts                     FoodShift[]                     @relation("FoodShiftPerson")
  foodScheduleOrganizations      FoodWorkSchedule[]              @relation("FoodWorkScheduleOrganization")
  foodSchedules                  FoodWorkSchedule[]              @relation("FoodWorkSchedulePerson")
  foodCustomerProfiles           FoodCustomerProfile[]           @relation("FoodCustomerProfileOrganization")
  foodCustomerOccurrences        FoodCustomerOccurrence[]        @relation("FoodCustomerOccurrenceOrganization")
  foodStockAlertOrganizations    FoodStockAlert[]                @relation("FoodStockAlertOrganization")
  foodPurchaseEventOrganizations FoodPurchaseEvent[]             @relation("FoodPurchaseEventOrganization")
  foodBirthdaySettings           FoodBirthdayAutomationSettings? @relation("FoodBirthdaySettingsOrganization")
  foodAuditOrganizations         FoodAuditEvent[]                @relation("FoodAuditOrganization")
  foodAuditActions               FoodAuditEvent[]                @relation("FoodAuditActor")

  @@index([assignedEstabelecimentoId])
  @@index([accountStatus])
  @@index([expiresAt])
  @@index([trialEndsAt])
  @@index([lastSeenAt])
}

model ServiceDashboardSettings {
  id                   String   @id @default(cuid())
  userId               Int      @unique
  monthlyRevenueGoalKz Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("service_dashboard_settings")
}

model LoginLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Contact {
  id               Int                      @id @default(autoincrement())
  name             String
  email            String
  phone            String
  company          String
  revenue          String?
  sector           String?
  location         String?
  birthDate        DateTime?
  lastActivityAt   DateTime?
  stage            String                   @default("Novo")
  inPipeline       Boolean                  @default(false)
  tags             String                   @default("[]")
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  userId           Int?
  customFields     String                   @default("{}")
  contactType      String                   @default("interessado")
  documents        String                   @default("[]")
  status           String                   @default("ativo")
  clienteType      String                   @default("particular")
  nif              String?
  dealValueKz      Float?
  contactGroupId   String?
  companyId        String?
  company_rel      Company?                 @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactGroup     ContactGroup?            @relation(fields: [contactGroupId], references: [id], onDelete: SetNull)
  user             User?                    @relation("ContactUser", fields: [userId], references: [id], onDelete: SetNull)
  notes            ContactNote[]
  formSubmissions  FormSubmission[]
  calendarEvents   CalendarEvent[]
  messages         Message[]
  tasks            Task[]
  dealStakeholders DealStakeholder[]
  transactions     Transaction[]
  automationLogs   AutomationLog[]
  automationAlerts AutomationAlert[]
  foodProfiles     FoodCustomerProfile[]
  foodOrders       FoodOrder[]
  foodOccurrences  FoodCustomerOccurrence[]

  @@unique([userId, phone], name: "user_phone_unique")
  @@index([companyId])
  @@index([contactGroupId])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, inPipeline])
  @@index([userId, stage])
  @@index([userId, lastActivityAt])
  @@index([userId, updatedAt])
  @@index([userId, status, birthDate])
  @@index([userId, birthDate])
}

model OrganizationModule {
  id              String   @id @default(cuid())
  organizationId  Int
  module          String
  enabled         Boolean  @default(true)
  planTier        String?
  settings        Json     @default("{}")
  createdByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organization    User     @relation("OrganizationModuleOrganization", fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, module])
  @@index([organizationId, enabled])
  @@map("organization_modules")
}

model ContactGroup {
  id             String    @id @default(cuid())
  userId         Int
  name           String
  normalizedName String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation("ContactGroupUser", fields: [userId], references: [id], onDelete: Cascade)
  contacts       Contact[]

  @@unique([userId, normalizedName])
}

model ContactNote {
  id          Int      @id @default(autoincrement())
  contactId   Int
  userId      Int?
  content     String
  attachments String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user        User?    @relation("NoteAuthor", fields: [userId], references: [id])
}

model ContactFieldDef {
  id        String   @id @default(cuid())
  userId    Int
  label     String
  key       String
  type      String   @default("text")
  options   String?
  required  Boolean  @default(false)
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation("ContactFieldDefUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model PipelineStage {
  id        String   @id @default(cuid())
  userId    Int
  name      String
  color     String   @default("#6b7e9a")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation("PipelineStageUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

// Acessos adicionais de uma pessoa a contas de outros donos.
model AccountMembership {
  id                        String   @id @default(cuid())
  personId                  Int
  accountOwnerId            Int
  role                      String   @default("user")
  permissions               String?
  assignedEstabelecimentoId String?
  active                    Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  person                    User     @relation("MembershipPerson", fields: [personId], references: [id], onDelete: Cascade)
  accountOwner              User     @relation("MembershipAccountOwner", fields: [accountOwnerId], references: [id], onDelete: Cascade)

  @@unique([personId, accountOwnerId])
  @@index([personId])
  @@index([accountOwnerId])
}

model ContactFieldConfig {
  id       String  @id @default(cuid())
  userId   Int
  fieldKey String
  label    String
  visible  Boolean @default(true)
  required Boolean @default(false)
  order    Int     @default(0)
  user     User    @relation("ContactFieldConfigUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fieldKey])
}

model Message {
  id        String   @id @default(cuid())
  contactId Int
  direction String
  text      String
  channel   String   @default("whatsapp")
  subject   String?
  timestamp DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

model Task {
  id                      Int       @id @default(autoincrement())
  contactId               Int?
  title                   String
  notes                   String?
  dueDate                 DateTime?
  priority                String    @default("Media")
  done                    Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  userId                  Int?
  assignedToUserId        Int?
  googleCalendarEventId   String?
  googleCalendarHtmlLink  String?
  googleCalendarSyncError String?
  googleCalendarSyncedAt  DateTime?
  source                  String    @default("manual")
  automationId            String?
  assignedTo              User?     @relation("TaskAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  contact                 Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  user                    User?     @relation("TaskUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([assignedToUserId])
  @@index([userId, dueDate])
  @@index([userId, done, dueDate])
  @@index([userId, done, contactId, dueDate])
  @@index([contactId])
  @@index([userId, source])
  @@index([automationId])
}

model Automation {
  id                   String            @id @default(cuid())
  trigger              String
  triggerValue         String?
  action               String
  targetStage          String?
  templateName         String?
  emailSubject         String?
  emailBody            String?
  active               Boolean           @default(true)
  userId               Int?
  formId               String?
  taskAssignedToUserId Int?
  taskDueDays          Int?
  taskNotes            String?
  taskPriority         String?
  taskTitle            String?
  form                 Form?             @relation(fields: [formId], references: [id])
  user                 User?             @relation("AutomationUser", fields: [userId], references: [id])
  logs                 AutomationLog[]
  alerts               AutomationAlert[]
}

model AutomationAlert {
  id           String      @id @default(cuid())
  userId       Int
  contactId    Int?
  automationId String?
  type         String
  title        String
  message      String?
  status       String      @default("open")
  createdAt    DateTime    @default(now())
  resolvedAt   DateTime?
  automation   Automation? @relation(fields: [automationId], references: [id], onDelete: SetNull)
  contact      Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([contactId])
  @@index([automationId])
  @@map("automation_alert")
}

model AutomationLog {
  id              String     @id @default(cuid())
  automation_id   String
  organization_id Int
  trigger_type    String
  trigger_data    Json
  action_type     String
  action_data     Json
  success         Boolean
  error_message   String?
  contact_id      Int?
  duration_ms     Int?
  created_at      DateTime   @default(now())
  automation      Automation @relation(fields: [automation_id], references: [id], onDelete: Cascade)
  contact         Contact?   @relation(fields: [contact_id], references: [id])
  organization    User       @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([automation_id, created_at])
  @@index([organization_id, created_at])
  @@index([organization_id, success])
  @@index([contact_id])
  @@map("automation_log")
}

model ActivityLog {
  id              String   @id @default(cuid())
  organization_id Int
  entity_type     String
  entity_id       String
  entity_label    String
  action          String
  field_changed   String?
  old_value       String?
  new_value       String?
  user_id         Int
  user_name       String
  metadata        Json?
  created_at      DateTime @default(now())

  @@index([organization_id, created_at])
  @@index([organization_id, entity_type, action, field_changed, created_at], map: "activity_log_org_stage_change_created_idx")
  @@index([entity_type, entity_id])
  @@map("activity_log")
}

model Form {
  id                String           @id @default(cuid())
  title             String
  description       String?
  mode              String           @default("step")
  thankYouUrl       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  userId            Int?
  bgColor           String?
  brandColor        String?
  logoUrl           String?
  googleTagEnabled  Boolean          @default(false)
  googleTagId       String?
  metaPixelEnabled  Boolean          @default(false)
  metaPixelId       String?
  trackSubmitAsLead Boolean          @default(true)
  automations       Automation[]
  user              User?            @relation("FormUser", fields: [userId], references: [id])
  fields            FormField[]
  submissions       FormSubmission[]
}

model FormField {
  id           String       @id @default(cuid())
  formId       String
  type         String
  label        String
  required     Boolean      @default(false)
  order        Int
  options      String?
  contactField String?
  answers      FormAnswer[]
  form         Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
}

model FormSubmission {
  id                String       @id @default(cuid())
  formId            String
  submittedAt       DateTime     @default(now())
  contactId         Int?
  contactSyncStatus String       @default("skipped")
  answers           FormAnswer[]
  contact           Contact?     @relation(fields: [contactId], references: [id])
  form              Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
}

model FormAnswer {
  id           String         @id @default(cuid())
  submissionId String
  fieldId      String?
  value        String
  contactField String?
  fieldLabel   String?
  field        FormField?     @relation(fields: [fieldId], references: [id])
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Transaction {
  id                     String       @id @default(cuid())
  date                   DateTime
  clientId               Int?
  clientName             String?
  type                   String
  revenueType            String?
  contractDurationMonths Int?
  nextPaymentDate        DateTime?
  category               String
  subcategory            String?
  description            String?
  amountKz               Float
  currencyOrigin         String       @default("KZ")
  exchangeRate           Float        @default(1.0)
  paymentMethod          String?
  status                 String       @default("pago")
  receiptNumber          String?
  notes                  String?
  deleted                Boolean      @default(false)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  userId                 Int?
  cashSessionId          String?      @map("cash_session_id")
  invoiceId              String?      @map("invoice_id")
  reconciled             Boolean      @default(false)
  reconciledAt           DateTime?    @map("reconciled_at")
  attachments            String       @default("[]")
  cashSession            CaixaSessao? @relation("TransactionCashSession", fields: [cashSessionId], references: [id])
  contact                Contact?     @relation(fields: [clientId], references: [id])
  invoice                Factura?     @relation("TransactionInvoice", fields: [invoiceId], references: [id])
  user                   User?        @relation("TransactionUser", fields: [userId], references: [id])

  @@index([invoiceId])
  @@index([cashSessionId])
  @@index([userId, invoiceId])
  @@index([userId, cashSessionId])
  @@index([userId, type, status, deleted, date])
  @@index([userId, clientId])
}

model FinancialCategory {
  id            String  @id @default(cuid())
  userId        Int?
  type          String
  category      String
  subcategories String?
  color         String?
  icon          String?
  active        Boolean @default(true)
  sortOrder     Int     @default(0)

  user User? @relation(fields: [userId], references: [id])

  @@unique([userId, type, category])
}

model GoogleCalendarToken {
  id                String    @id @default(cuid())
  userId            Int       @unique
  accessToken       String
  refreshToken      String?
  expiresAt         DateTime
  googleEmail       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastSyncAt        DateTime?
  lastSyncError     String?
  lastSyncErrorAt   DateTime?
  primaryCalendarId String    @default("primary")
  provider          String    @default("google")
  scope             String?
  status            String    @default("connected")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CalendarEvent {
  id                      String    @id @default(cuid())
  userId                  Int
  contactId               Int?
  assignedToUserId        Int?
  title                   String
  notes                   String?
  startDate               DateTime
  endDate                 DateTime
  syncWithGoogle          Boolean   @default(false)
  googleCalendarEventId   String?
  googleCalendarHtmlLink  String?
  googleCalendarSyncError String?
  googleCalendarSyncedAt  DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  assignedTo              User?     @relation("CalendarEventAssignee", fields: [assignedToUserId], references: [id])
  contact                 Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  user                    User      @relation("CalendarEventUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([assignedToUserId, startDate])
  @@index([contactId])
  @@index([userId, startDate])
  @@index([googleCalendarEventId])
}

model GoogleCalendarEvent {
  id              String    @id @default(cuid())
  userId          Int
  calendarId      String    @default("primary")
  googleEventId   String
  title           String
  description     String?
  location        String?
  startAt         DateTime
  endAt           DateTime
  isAllDay        Boolean   @default(false)
  status          String    @default("confirmed")
  htmlLink        String?
  sourceUpdatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, calendarId, googleEventId])
  @@index([userId, startAt])
  @@index([userId, endAt])
  @@index([userId, status])
}

model CalendarSync {
  id           String   @id @default(cuid())
  userId       Int      @unique
  channelId    String   @unique
  resourceId   String
  channelToken String
  syncToken    String?
  watchExpiry  DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Estabelecimento {
  id                 String              @id @default(cuid())
  userId             Int
  nome               String
  nif                String
  morada             String?
  telefone           String?
  email              String?
  isPrincipal        Boolean             @default(false)
  createdAt          DateTime            @default(now())
  defaultSerieId     String?
  caixaSessoes       CaixaSessao[]
  defaultSerie       Serie?              @relation("EstabelecimentoDefaultSerie", fields: [defaultSerieId], references: [id])
  user               User                @relation("EstabelecimentoUser", fields: [userId], references: [id], onDelete: Cascade)
  facturas           Factura[]
  facturaRecorrentes FacturaRecorrente[]
  series             Serie[]             @relation("EstabelecimentoSeries")
  assignedUsers      User[]              @relation("AssignedEstabelecimento")
  foodBranches       FoodBranch[]        @relation("FoodBranchEstabelecimento")
}

model FoodSettings {
  id                             String   @id @default(cuid())
  userId                         Int      @unique
  isEnabled                      Boolean  @default(false)
  restaurantName                 String?
  logoUrl                        String?
  primaryColor                   String   @default("#0f766e")
  secondaryColor                 String?
  restaurantPhone                String?
  restaurantEmail                String?
  restaurantAddress              String?
  currency                       String   @default("AOA")
  timezone                       String   @default("Africa/Luanda")
  defaultPreparationMinutes      Int      @default(20)
  kdsGreenMinutes                Int      @default(15)
  kdsYellowMinutes               Int      @default(25)
  kdsRedMinutes                  Int      @default(35)
  orderTypes                     String   @default("[\"delivery\",\"pickup\",\"dine_in\"]")
  paymentMethods                 String   @default("[\"CASH\",\"MULTICAIXA\",\"TPA\",\"TRANSFER\"]")
  kitchenSoundEnabled            Boolean  @default(true)
  kitchenSoundVolume             Float    @default(0.7)
  kitchenSoundRepeatSeconds      Int      @default(20)
  kdsUnacceptedWarningSeconds    Int      @default(60)
  kdsUnacceptedEscalationSeconds Int      @default(120)
  kdsReadyReminderMinutes        Int      @default(5)
  createdByUserId                Int?
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
  user                           User     @relation("FoodSettingsUser", fields: [userId], references: [id], onDelete: Cascade)

  @@map("food_settings")
}

model FoodBranch {
  id                  String                    @id @default(cuid())
  userId              Int
  estabelecimentoId   String?
  name                String
  phone               String?
  email               String?
  address             String?
  neighborhood        String?
  isMain              Boolean                   @default(false)
  active              Boolean                   @default(true)
  createdByUserId     Int?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  user                User                      @relation("FoodBranchUser", fields: [userId], references: [id], onDelete: Cascade)
