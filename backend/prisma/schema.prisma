  targetSales        Int?         @map("target_sales")
  targetRevenue      Decimal?     @map("target_revenue") @db.Decimal(18, 2)
  maxCostPerContact  Decimal?     @map("max_cost_per_contact") @db.Decimal(18, 2)
  minEstimatedReturn Decimal?     @map("min_estimated_return") @db.Decimal(10, 2)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  client             GrowthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("growth_client_goals")
}

model GrowthClientAccess {
  id        String       @id @default(uuid()) @db.Uuid
  clientId  String       @map("client_id") @db.Uuid
  userId    Int          @unique @map("user_id")
  active    Boolean      @default(true)
  invitedAt DateTime     @default(now()) @map("invited_at")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  client    GrowthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User         @relation("GrowthClientAccessUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId, active])
  @@map("growth_client_accesses")
}

model GrowthPerformancePeriod {
  id                String                   @id @default(uuid()) @db.Uuid
  clientId          String                   @map("client_id") @db.Uuid
  periodName        String                   @map("period_name")
  startDate         DateTime                 @map("start_date") @db.Date
  endDate           DateTime                 @map("end_date") @db.Date
  investment        Decimal                  @default(0) @db.Decimal(18, 2)
  contacts          Int                      @default(0)
  qualifiedContacts Int                      @default(0) @map("qualified_contacts")
  meetings          Int                      @default(0)
  proposals         Int                      @default(0)
  sales             Int                      @default(0)
  attributedRevenue Decimal                  @default(0) @map("attributed_revenue") @db.Decimal(18, 2)
  executiveSummary  String?                  @map("executive_summary")
  mainBottleneck    String?                  @map("main_bottleneck")
  recommendation    String?
  status            String                   @default("draft")
  sourceSystem      String                   @default("manual") @map("source_system")
  externalId        String?                  @map("external_id")
  archivedAt        DateTime?                @map("archived_at")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  client            GrowthClient             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sources           GrowthContactSource[]
  campaigns         GrowthCampaignAction[]
  strategicReading  GrowthStrategicReading?
  decisions         GrowthNextDecision[]
  report            GrowthPerformanceReport?
  publications      GrowthPublication[]

  @@unique([clientId, externalId])
  @@index([clientId, startDate, status])
  @@map("growth_performance_periods")
}

model GrowthContactSource {
  id                String                  @id @default(uuid()) @db.Uuid
  periodId          String                  @map("period_id") @db.Uuid
  sourceName        String                  @map("source_name")
  contacts          Int                     @default(0)
  qualifiedContacts Int                     @default(0) @map("qualified_contacts")
  meetings          Int                     @default(0)
  proposals         Int                     @default(0)
  sales             Int                     @default(0)
  revenue           Decimal                 @default(0) @db.Decimal(18, 2)
  qualityLabel      String                  @default("medium") @map("quality_label")
  strategicReading  String?                 @map("strategic_reading")
  externalId        String?                 @map("external_id")
  sortOrder         Int                     @default(0) @map("sort_order")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  period            GrowthPerformancePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, externalId])
  @@index([periodId, sortOrder])
  @@map("growth_contact_sources")
}

model GrowthCampaignAction {
  id         String                  @id @default(uuid()) @db.Uuid
  periodId   String                  @map("period_id") @db.Uuid
  name       String
  objective  String?
  sourceName String?                 @map("source_name")
  investment Decimal                 @default(0) @db.Decimal(18, 2)
  contacts   Int                     @default(0)
  sales      Int                     @default(0)
  revenue    Decimal                 @default(0) @db.Decimal(18, 2)
  status     String                  @default("testing")
  decision   String?
  note       String?
  externalId String?                 @map("external_id")
  sortOrder  Int                     @default(0) @map("sort_order")
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")
  period     GrowthPerformancePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, externalId])
  @@index([periodId, sortOrder])
  @@map("growth_campaign_actions")
}

model GrowthStrategicReading {
  id                  String                  @id @default(uuid()) @db.Uuid
  periodId            String                  @unique @map("period_id") @db.Uuid
  whatHappened        String?                 @map("what_happened")
  whatDataShows       String?                 @map("what_data_shows")
  bottleneck          String?
  businessMeaning     String?                 @map("business_meaning")
  recommendedDecision String?                 @map("recommended_decision")
  nextActions         String?                 @map("next_actions")
  clientNeeds         String?                 @map("client_needs")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  period              GrowthPerformancePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@map("growth_strategic_readings")
}

model GrowthNextDecision {
  id             String                  @id @default(uuid()) @db.Uuid
  periodId       String                  @map("period_id") @db.Uuid
  decision       String
  reason         String?
  owner          String?
  priority       String                  @default("medium")
  status         String                  @default("next_action")
  expectedImpact String?                 @map("expected_impact")
  sortOrder      Int                     @default(0) @map("sort_order")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  period         GrowthPerformancePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId, sortOrder])
  @@map("growth_next_decisions")
}

model GrowthPerformanceReport {
  id               String                  @id @default(uuid()) @db.Uuid
  periodId         String                  @unique @map("period_id") @db.Uuid
  executiveSummary String?                 @map("executive_summary")
  mainLearnings    String?                 @map("main_learnings")
  whatWorked       String?                 @map("what_worked")
  whatDidNotWork   String?                 @map("what_did_not_work")
  decisionsTaken   String?                 @map("decisions_taken")
  nextSteps        String?                 @map("next_steps")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  period           GrowthPerformancePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@map("growth_performance_reports")
}

model GrowthPublication {
  id            String                  @id @default(uuid()) @db.Uuid
  periodId      String                  @map("period_id") @db.Uuid
  version       Int
  snapshot      Json
  publishedById Int?                    @map("published_by_id")
  publishedAt   DateTime                @default(now()) @map("published_at")
  period        GrowthPerformancePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, version])
  @@index([periodId, publishedAt])
  @@map("growth_publications")
}
