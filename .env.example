# ============================================================
# KukuGest — referência de variáveis de ambiente
# Copiar para backend/.env e frontend/.env.local conforme indicado
# ============================================================

# ============================================================
# BACKEND (.env)
# ============================================================

PORT=3001
# IMPORTANTE (produção): limitar SEMPRE o pool de ligações do Prisma para não
# esgotar as ligações do Postgres sob carga (vários utilizadores em simultâneo).
#   connection_limit = (max_connections do plano Postgres − margem) ÷ nº de instâncias web
# Ex.: plano com 97 ligações, 1 instância web → connection_limit≈20 (deixa folga p/ admin/migrações).
# Se o fornecedor expuser pooler/PgBouncer, usar o host do pooler em vez do host direto.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require&connection_limit=20&pool_timeout=20&connect_timeout=10
FRONTEND_URL=http://localhost:3000
ALLOWED_VERCEL_URL=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=generate-a-long-random-secret
SUPER_ADMIN_EMAIL=admin@example.com
SETUP_SECRET=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OWNER_EMAIL=
WEBHOOK_VERIFY_TOKEN=
WABA_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
FRONTEND_CALENDAR_URL=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_WEBHOOK_ADDRESS=

AGT_API_URL=https://sifphml.minfin.gov.ao/sigt/fe/v1
AGT_MOCK_MODE=true
AGT_CERT_NUMBER=PENDING
SOFTWARE_PRODUCT_ID=KukuGest
SOFTWARE_VERSION=1.0.0
NIF_EMPRESA=
COMPANY_NAME=

ZIETT_ENABLE=true
ZIETT_BASE_URL=https://api.ziett.co
ZIETT_API_KEY=
ZIETT_DEFAULT_REMITTER_ID=
ZIETT_DEFAULT_CHANNEL=SMS
ZIETT_DEFAULT_COUNTRY=AO
ZIETT_TEST_ALLOWED_RECIPIENTS=+244900000000,+244911111111

MAZANGA_WEBHOOK_SECRET=
MAZANGA_LEAD_OWNER_EMAIL=

# ============================================================
# Gateway de pagamento E+ Kwanza (AppyPay)
# ============================================================
# Autenticação OAuth2 (tenant de produção)
EKWANZA_TOKEN_URL=https://login.microsoftonline.com/auth.appypay.co.ao/oauth2/token
EKWANZA_BASE_URL=https://gwy-api.appypay.co.ao
EKWANZA_CLIENT_ID=
EKWANZA_CLIENT_SECRET=
EKWANZA_RESOURCE=
# Identificação do comerciante e chave da conta
EKWANZA_MERCHANT_IDENTIFIER=
EKWANZA_API_KEY=
# GUIDs dos métodos de pagamento (sem o prefixo GPO_/REF_)
EKWANZA_PAYMENT_METHOD_GPO=
EKWANZA_PAYMENT_METHOD_REF=
# Para validar a assinatura do callback nativo /Ticket
EKWANZA_NOTIFICATION_TOKEN=
EKWANZA_MERCHANT_REGISTRATION_NO=

# Desenvolvimento local apenas. Nunca activar em produção.
BYPASS_AUTH=false

# ============================================================
# FRONTEND (.env.local)
# ============================================================

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=change-me-for-vercel-cron
